# TruthLock frontend configuration (Vite: import.meta.env, all vars prefixed VITE_)
# Copy to .env (or .env.local) and fill in after deploying the contract.

# FactChecker contract address — printed by `genlayer deploy --contract contract/fact_checker.py`
VITE_CONTRACT_ADDRESS=

# Network must match one of genlayer-js/chains:
# localnet | studionet | testnetAsimov | testnetBradbury
VITE_NETWORK=studionet

# Optional: GovernanceDAO contract (contract/governance_dao.py) — enables the /governance page
VITE_GOVERNANCE_ADDRESS=

# Block explorer base URL, used to link transactions on the Result page.
# Studionet canonical explorer. Do NOT use genlayer-explorer.vercel.app —
# that deployment is paused by its owner (HTTP 503 DEPLOYMENT_PAUSED).
VITE_EXPLORER_URL=https://explorer-studio.genlayer.com
